{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nesting",
  "main": "./worker/serula-worker.js",
  "compatibility_date": "2026-09-29",
  "routes": [
    {
      "pattern": "serula.site",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "triggers": {
    "crons": ["17 3 * * *"]
  },
  "send_email": [{"name": "EMAIL"}],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "serula-db",
      "database_id": "109b29ed-a1e1-4fc9-a39f-b9865e2eaa56"
    }
  ]
}
