{
  "name": "serula-nesting",
  "private": true,
  "version": "0.0.110",
  "type": "module",
  "scripts": {
    "source:check": "node scripts/check-source-integrity.mjs",
    "wasm:build": "node scripts/build-wasm.mjs",
    "wasm:verify": "node scripts/verify-prebuilt-wasm.mjs",
    "test-dxf:catalog": "node scripts/generate-test-dxf-catalog.mjs",
    "dev": "npm run test-dxf:catalog && vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "build": "npm run test-dxf:catalog && npm run source:check && npm run wasm:verify && npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.6",
    "typescript": "5.8.3",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.12",
    "dxf": "5.3.1",
    "jspdf": "4.2.1",
    "polygon-clipping": "0.15.7",
    "polylabel": "2.1.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "robust-predicates": "3.0.2",
    "svg2pdf.js": "2.8.1"
  }
}
